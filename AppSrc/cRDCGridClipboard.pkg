//****************************************************************************
// $Module type: Package
// $Module name: cRDCGridClipboard.pkg
//
// $Author     : Nils Svedmyr, RDC Tools International.
// Copyright (c) 2026 RDC Tools International
// E-mail      : support@rdctools.com
// Web-site    : http://www.rdctools.com
//
// Created     : 2026-10-08 (DFRefactor's grids carried a Copy of their own each until then)
//
// Note        : A CodeJock grid's rows as text, and onto the clipboard: the selected rows - the
//               current row when none is selected - one line each, the values of the columns asked
//               for joined by a tab. Global functions that take the grid, so every grid class has
//               them without a change of its own - cRDCCJGrid, cRDCDbCJGrid, cRDCToolTipGrid, a plain
//               cCJGrid - from a Copy of the grid's own, which Ctrl+C or a context menu sends:
//
//                   Procedure Copy
//                       Handle[] ahoColumns
//                       Integer iRows
//                       Move (oFile_Col(Self)) to ahoColumns[-1]
//                       Move (oLine_Col(Self)) to ahoColumns[-1]
//                       Get RDCCopyGridRows Self ahoColumns to iRows
//                       If (iRows > 0) ;
//                           Set StatusText of (Statusbar_Id(Self)) to (String(iRows) * "row(s) copied.")
//                   End_Procedure
//
//               An empty array of columns takes every value of the row, in the data source's order.
//               The rows come from the grid's data source, so what is copied is what the grid holds;
//               a column's own rendering - an image, a check box - is not.
//
// The code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
// This is free software; you can redistribute it and/or modify it under the terms of the
// GNU Lesser General Public License - see the "GNU Lesser General Public License.txt"
// in the help folder for more details.
//
Use cCJGrid.pkg                // phoDataSource, GetIndexesForSelectedRows, tDataSourceRow
Use seq_chnl.pkg               // Seq_New_Channel - the clipboard is written as a sequential channel

// The rows to take: the grid's selection, or the current row when nothing is selected; none when the grid has
// no data source or no current row.
Function RDCGridSelectedRows Global Handle hoGrid Returns Integer[]
    Handle hoDataSource
    Integer[] aiRows
    Integer iItem

    Get phoDataSource of hoGrid to hoDataSource
    If (hoDataSource = 0) ;
        Function_Return aiRows
    Get GetIndexesForSelectedRows of hoGrid to aiRows
    If (SizeOfArray(aiRows) = 0) Begin
        Get SelectedRow of hoDataSource to iItem
        If (iItem >= 0) ;
            Move iItem to aiRows[0]
    End
    Function_Return aiRows
End_Function

// The rows' text: one line per row (CR LF), the values of the columns in ahoColumns - column objects, in that
// order; every value of the row when the array is empty - joined by a tab. "" when there is no row.
Function RDCGridRowsText Global Handle hoGrid Handle[] ahoColumns Returns String
    Handle hoDataSource
    tDataSourceRow[] TheData
    Integer[] aiRows aiCols
    Integer i j iItem iMax jMax
    String sOut sLine sTab sCRLF

    Get RDCGridSelectedRows hoGrid to aiRows
    If (SizeOfArray(aiRows) = 0) ;
        Function_Return ""
    Get phoDataSource of hoGrid to hoDataSource
    Get DataSource of hoDataSource to TheData
    Move (SizeOfArray(ahoColumns) - 1) to jMax
    For j from 0 to jMax
        Get piColumnId of ahoColumns[j] to aiCols[j]
    Loop
    Move (Character(9)) to sTab
    Move (Character(13) + Character(10)) to sCRLF
    Move "" to sOut
    Move (SizeOfArray(aiRows) - 1) to iMax
    For i from 0 to iMax
        Move aiRows[i] to iItem
        If ((iItem >= 0) and (iItem < SizeOfArray(TheData))) Begin
            Move "" to sLine
            If (jMax < 0) Begin
                For j from 0 to (SizeOfArray(TheData[iItem].sValue) - 1)
                    Move (sLine + (If(j > 0, sTab, "")) + TheData[iItem].sValue[j]) to sLine
                Loop
            End
            Else Begin
                For j from 0 to jMax
                    Move (sLine + (If(j > 0, sTab, "")) + TheData[iItem].sValue[aiCols[j]]) to sLine
                Loop
            End
            Move (sOut + sLine + sCRLF) to sOut
        End
    Loop
    Function_Return sOut
End_Function

// The rows' text onto the clipboard; the number of rows copied - 0 when there was none, or no channel was free.
Function RDCCopyGridRows Global Handle hoGrid Handle[] ahoColumns Returns Integer
    Integer[] aiRows
    Integer iCh
    String sText

    Get RDCGridSelectedRows hoGrid to aiRows
    If (SizeOfArray(aiRows) = 0) ;
        Function_Return 0
    Get RDCGridRowsText hoGrid ahoColumns to sText
    Move (Seq_New_Channel()) to iCh
    If (iCh < 0) ;
        Function_Return 0
    Direct_Output channel iCh "Clipboard:"
    Write channel iCh sText
    Close_Output channel iCh
    Send Seq_Release_Channel iCh
    Function_Return (SizeOfArray(aiRows))
End_Function
