//****************************************************************************
// $Module type: Class
// $Module name: cRDCCJToolPanelGrid
// $Author     : Nils Svedmyr, RDC Tools International.
// Copyright (c) 2026 RDC Tools International
// E-mail      : support@rdctools.com
// Web-site    : http://www.rdctools.com
//
// Created     : 2026-10-08 - the grid-side half of cRDCCJToolPanel's context-menu contract, as DFRefactor's
//               four dock grids carried it since 2024 and sharpened it in 2026.
//
// Description : A grid inside a cRDCCJToolPanel. The panel owns ONE context menu for whatever is inside it
//               (phoToolPanelContextMenu) and names the object that invoked it (phInvokingObject), which is
//               what a menu command acts on. A grid of this class claims the menu for itself when it takes
//               the focus, and again on a right-click - a right-click on a grid that has not taken the
//               focus first, the tab beside the one that held it, would otherwise act on the sibling - and
//               then pops the menu. Just before it pops, OnToolPanelMenuPopup hands the grid the menu, to
//               grey an item that does not apply to it, or to its current row.
//
//               A cRDCToolTipGrid, so the program's tooltip settings come with it (cRDCGridToolTip.pkg).
//
// The code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
// This is free software; you can redistribute it and/or modify it under the terms of the
// GNU Lesser General Public License - see the "GNU Lesser General Public License.txt"
// in the help folder for more details.
//
//****************************************************************************
Use cRDCGridToolTip.pkg        // cRDCToolTipGrid
Use cRDCCJToolPanel.pkg        // phInvokingObject, phoToolPanelContextMenu - the panel's half of the contract

Class cRDCCJToolPanelGrid is a cRDCToolTipGrid

    // The grid that has the focus is the one the menu acts on.
    Procedure Add_Focus Handle hoParent Returns Integer
        Integer iErr

        Forward Get msg_Add_Focus hoParent to iErr
        Set phInvokingObject to Self
        Procedure_Return iErr
    End_Procedure

    // Just before the menu pops for this grid: grey what does not apply to it, or to its current row.
    Procedure OnToolPanelMenuPopup Handle hoMenu
    End_Procedure

    // A right-click claims the menu afresh - the focus may still be on a sibling - and pops it.
    Procedure OnComRowRClick Variant llRow Variant llItem
        Handle hoMenu

        Set phInvokingObject to Self
        Move (phoToolPanelContextMenu(Self)) to hoMenu
        If (hoMenu = 0) ;
            Procedure_Return
        Send OnToolPanelMenuPopup hoMenu
        Send Popup to hoMenu
    End_Procedure

End_Class
