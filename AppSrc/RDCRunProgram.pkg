//****************************************************************************
// $Module type: Procedures (Global)
// $Module name: RDCRunProgram
// $Author     : Nils Svedmyr, RDC Tools International.
// Copyright (c) 2026 RDC Tools International
// E-mail      : support@rdctools.com
// Web-site    : http://www.rdctools.com
//
// Created     : 2026-10-09 - DFRefactor's RFRunProgram.pkg of 2026 (itself lifted out of DUF's
//               WsGlobalFunctions.pkg) as a library package, the strings reaching Windows in the
//               ANSI code page.
//               2026-11-07 - From DataFlex 20 the strings go to ShellExecuteExW, every character as
//               it is.
//
// Description : What a program hands to the Windows shell, through ShellExecuteEx.
//
//               RDCShellExecuteEx is the one place that calls it. From DataFlex 20 a string is UTF-8,
//               and it goes to ShellExecuteExW as a WString - UTF-16, the text Windows itself works
//               in - so every character of a path or a parameter reaches the shell as it is. The
//               ANSI ShellExecuteEx, which the package used before, takes only the characters of the
//               machine's ANSI code page: any other one (a Polish, Greek or Chinese letter on a
//               Western European Windows, say) became '?' or a look-alike letter, and the shell
//               found no such file. Before DataFlex 20 a string is OEM and there is no WString;
//               the ANSI ShellExecuteEx is used there, after ToANSI, as before.
//
//               RDCRunProgramWait launches a program and blocks until it exits, with no console
//               window flashing for a console-subsystem child (the DataFlex compiler is one).
//               BLOCKING: the message pump is frozen meanwhile. It can never be safe for a tool that
//               might ask a question - ShellExecuteEx cannot redirect the child's input, and the
//               wait is infinite - so such a tool runs through RDCRunProgramBounded
//               (cRDCAsyncProcess.pkg), through a wrapper that redirects its output.
//
//               RDCRevealInExplorer opens Windows Explorer with a file selected in its folder, or a
//               folder opened; RDCOpenHelpPage opens a local .htm/.html page in the user's own
//               browser; RDCOpenUrl hands an http or https address to it. The three return at once,
//               and each takes the string only where it names something real - a path on disk, a
//               page, a web address: handing an arbitrary string to the shell is a way to run
//               things, and with the checks the worst a bad caller can do is show the user
//               something. Silent on refusal: a caller passing a path that is missing or not a
//               page has a bug, and a message box in a shell helper is not where that gets
//               diagnosed.
//
// The code is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY;
// without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
// This is free software; you can redistribute it and/or modify it under the terms of the
// GNU Lesser General Public License - see the "GNU Lesser General Public License.txt"
// in the help folder for more details.
//
//****************************************************************************
Use Windows.pkg
Use StartProg.pkg              // CloseHandleEf
Use vWin32fh.pkg               // vFilePathExists, vFolderExists

// Before DataFlex 20 a string is OEM, not UTF-8, and there is no Utf8ToAnsi. ToANSI is the conversion that is
// right there, so it stands in under that name. Nothing here calls it any more - RDCShellExecuteEx converts
// for itself - but a program on DataFlex 19.1 may have come to rely on finding it in this package.
#IF (!@ < 200)
#IFNDEF get_Utf8ToAnsi
Function Utf8ToAnsi Global String sText Returns String
    Function_Return (ToANSI(sText))
End_Function
#ENDIF
#ENDIF

Struct tRDCShellExecuteInfo
    DWord   cbSize
    Integer fMask
    Handle  hwnd
    Pointer lpVerb
    Pointer lpFile
    Pointer lpParameters
    Pointer lpDirectory
    Integer nShow
#IFDEF IS$WIN64
    Integer iMissingAlignment1
#ENDIF
    Pointer hInstApp
    Pointer lpIDList
    Pointer lpClass
    Handle  hkeyClass
    DWord   dwHotKey
#IFDEF IS$WIN64
    Integer iMissingAlignment2
#ENDIF
    Handle  hIconMonitor // Union
    //Handle  hMonitor     // Union
    Handle  hProcess
End_Struct

// SEE_MASK_NOCLOSEPROCESS (0x40): the started process's handle is wanted back. Prefixed, since DUF's
// WsGlobalFunctions.pkg defines the plain name without a guard.
Define RDC_SEE_MASK_NOCLOSEPROCESS for 64

// The ANSI entry point - the plain name is ShellExecuteExA in Shell32.dll. RDCShellExecuteEx calls it before
// DataFlex 20; it stays declared here for a program that calls it itself, with ANSI strings.
#IFNDEF get_ShellExecuteExEf
    External_Function ShellExecuteExEf "ShellExecuteEx" Shell32.dll Pointer pExecInfo Returns Integer
#ENDIF

// The wide entry point: RDCShellExecuteEx calls it from DataFlex 20, the lpFile and lpParameters of the struct
// the addresses of WStrings. A name of its own, not ShellExecuteExEf: under that name's #IFNDEF an ANSI
// declaration from another package would win without a word, and Windows would read every UTF-16 string as a
// one-letter ANSI one. Declared on every version - Windows has it on all of them.
#IFNDEF get_RDCShellExecuteExWEf
    External_Function RDCShellExecuteExWEf "ShellExecuteExW" Shell32.dll Pointer pExecInfo Returns Integer
#ENDIF

#IFNDEF get_WaitForSingleObjectEf
    External_Function WaitForSingleObjectEf "WaitForSingleObject" Kernel32.dll Handle hHandle DWord dwMilliseconds Returns DWord
#ENDIF

// Hands sFile to the Windows shell: a program to start, a document or an address to open. Returns True when
// the shell did. The procedures below go through it, and so can a program that wants a launch of its own
// kind - shown, say, and waited on in a loop of its own.
//   sFile        The program, document or address.
//   sParameters  The command line for a program; "" for none (a document or an address takes none).
//   iMask        The SEE_MASK flags. RDC_SEE_MASK_NOCLOSEPROCESS: the started process's handle is wanted back.
//   iShow        How the window shows: 0 (SW_HIDE) hidden, 1 (SW_SHOWNORMAL) shown.
//   hProcess     The started process's handle when iMask asks for it and the shell started a process,
//                otherwise 0. The caller closes it (CloseHandleEf).
// The strings go to ShellExecuteExW as WStrings from DataFlex 20, and to the ANSI ShellExecuteEx after ToANSI
// before it. A WString ends with a zero character of its own, as the wide calls in DataFlex's own
// cApplication.pkg rely on.
Function RDCShellExecuteEx Global String sFile String sParameters Integer iMask Integer iShow Handle ByRef hProcess Returns Boolean
    Integer iRet
    tRDCShellExecuteInfo sInfo
#IF (!@ < 200)
    String  sFileA sParametersA
#ELSE
    WString wFile wParameters
#ENDIF

    Move 0 to hProcess
    Move (SizeOfType(tRDCShellExecuteInfo)) to sInfo.cbSize
    Move iMask to sInfo.fMask
    Move iShow to sInfo.nShow
#IF (!@ < 200)
    Move (ToANSI(sFile)) to sFileA
    Move (AddressOf(sFileA)) to sInfo.lpFile
    If (sParameters <> "") Begin
        Move (ToANSI(sParameters)) to sParametersA
        Move (AddressOf(sParametersA)) to sInfo.lpParameters
    End
    Move (ShellExecuteExEf(AddressOf(sInfo))) to iRet
#ELSE
    Move sFile to wFile
    Move (AddressOf(wFile)) to sInfo.lpFile
    If (sParameters <> "") Begin
        Move sParameters to wParameters
        Move (AddressOf(wParameters)) to sInfo.lpParameters
    End
    Move (RDCShellExecuteExWEf(AddressOf(sInfo))) to iRet
#ENDIF
    Move sInfo.hProcess to hProcess
    Function_Return (iRet <> 0)
End_Function

// Launches sProgram with sParameter and blocks until the process exits. Unlike a plain Runprogram, no
// console window flashes for a console-subsystem child: the window is hidden. From DataFlex 20 every
// character of the program's path and of its parameters reaches the shell as it is (RDCShellExecuteEx).
Procedure RDCRunProgramWait Global String sProgram String sParameter
    Handle hProcess
    Integer iVoid
    Boolean bStarted

    // 0 = SW_HIDE - no flash of a console window for a console child
    Move (RDCShellExecuteEx(sProgram, sParameter, RDC_SEE_MASK_NOCLOSEPROCESS, 0, &hProcess)) to bStarted
    If (hProcess) Begin
        Move (WaitForSingleObjectEf(hProcess, -1)) to iVoid
        Move (CloseHandleEf(hProcess)) to iVoid
    End
End_Procedure

// Opens Windows Explorer showing sPath - a file SELECTED in its folder, or a folder opened. Nothing is
// waited on, and the window is shown. THE PATH MUST EXIST, and that is checked here rather than at the
// caller: requiring a real file or folder on disk means the worst a bad caller can do is show the user
// a directory. explorer.exe is named for the same reason - the shell picks no handler from the string.
// /select needs the path QUOTED: Explorer takes everything after the comma as the target, and an
// unquoted path stops at the first space, which is most of Program Files.
Procedure RDCRevealInExplorer Global String sPath
    Handle hVoid
    String sArgs
    Boolean bIsDir bVoid

    Move (Trim(sPath)) to sPath
    If (sPath = "") ;
        Procedure_Return
    Move (vFolderExists(sPath)) to bIsDir
    If (bIsDir = False and (vFilePathExists(sPath)) = False) ;
        Procedure_Return

    If (bIsDir = True) ;
        Move ('"' + sPath + '"') to sArgs
    Else ;
        Move ('/select,"' + sPath + '"') to sArgs

    // Mask 0: nothing waited on, so no handle wanted back. 1 = SW_SHOWNORMAL - the window must be visible.
    Move (RDCShellExecuteEx("explorer.exe", sArgs, 0, 1, &hVoid)) to bVoid
End_Procedure

// Opens a LOCAL .htm/.html page in whatever the user has set as their browser. Separate from
// RDCOpenUrl, which refuses anything but http and https - so a page shipped with a program cannot go
// through it, and a file:/// address is exactly what it exists to reject. Two narrow doors beat one
// wide one. The two guards are the whole procedure: the file must exist, and it must be a page -
// without the extension test this would launch an .exe, a .bat or a .lnk as happily as a document.
// The shell's default handler opens it: the user's chosen browser, and no program is named here,
// since naming one would mean picking a browser on the user's behalf.
Procedure RDCOpenHelpPage Global String sPath
    Handle hVoid
    String sLow
    Boolean bVoid

    Move (Trim(sPath)) to sPath
    If (sPath = "") ;
        Procedure_Return
    If ((vFilePathExists(sPath)) = False) ;
        Procedure_Return
    Move (Lowercase(sPath)) to sLow
    If (Right(sLow, 5) <> ".html" and (Right(sLow, 4)) <> ".htm") ;
        Procedure_Return

    // No verb = the shell's default one ("open") for .htm/.html. Mask 0: nothing waited on, so no handle
    // wanted back. 1 = SW_SHOWNORMAL - the browser must be visible.
    Move (RDCShellExecuteEx(sPath, "", 0, 1, &hVoid)) to bVoid
End_Procedure

// Hands sTarget to the shell's default handler - the browser, for an http or https address - and
// returns at once. http and https ONLY: a shell "open" on an arbitrary string is a way to run things,
// so the scheme is checked here rather than trusted from the caller.
Procedure RDCOpenUrl Global String sTarget
    Handle hVoid
    String sLow
    Boolean bVoid

    Move (Lowercase(Trim(sTarget))) to sLow
    If (Left(sLow, 8) <> "https://" and Left(sLow, 7) <> "http://") ;
        Procedure_Return

    // No verb = the shell's default one ("open"). Mask 0: nothing waited on, so no handle wanted back.
    // 1 = SW_SHOWNORMAL - the browser must be visible.
    Move (RDCShellExecuteEx(sTarget, "", 0, 1, &hVoid)) to bVoid
End_Procedure
