// oRDCFileFunctions-Tests.pkg - cRDCFileFunctions (ghoRDCFileFunctions) hands Windows wide text from DataFlex 20:
// ApplicationPath reads the program's folder with GetModuleFileNameW, and FileTimeWinApi opens a file with
// CreateFileW. Until 1.0.18 both went through the ANSI functions, so a folder with a national letter in its name came
// back garbled or was not found.
//
// From DataFlex 20 the test folder's name holds a Polish L with stroke, a z with acute and two Chinese characters - see
// oRDCCreateProcess-Tests.pkg for why the Chinese ones decide it. Before DataFlex 20 a string is OEM and cannot hold
// them: the folder has a plain name there, and the tests only prove that the functions still work.
//
// Everything happens in one folder of the test's own under TEMP, which cmd.exe makes and removes.

Use DFUnit\Fixturing\Fixture.pkg
Use cRDCAsyncProcess.pkg        // RDCRunProgramBounded - cmd.exe makes the folder and the file, and removes them
Use cRDCFileFunctions.pkg
Use vWin32fh.pkg                // vFolderExists, vFilePathExists

Object oRDCFileFunctions_Tests is a cTestFixture
    Set psTestFixtureName to "cRDCFileFunctions - the program's folder, and a file in a folder with any name"

    Property String psFileFunctionsBase   ""
    Property String psFileFunctionsFolder ""

    // The test folder's name. From DataFlex 20 it is built from its UTF-8 bytes, so this source stays ASCII.
    Function FileFunctionsFolderName Returns String
#IF (!@ < 200)
        Function_Return "RDC plain folder"
#ELSE
        UChar[] aBytes

        Move 197 to aBytes[0]     // C5 81    L with stroke, U+0141
        Move 129 to aBytes[1]
        Move 195 to aBytes[2]     // C3 B3    o with acute, U+00F3
        Move 179 to aBytes[3]
        Move 100 to aBytes[4]     // 64       d
        Move 197 to aBytes[5]     // C5 BA    z with acute, U+017A
        Move 186 to aBytes[6]
        Move 32  to aBytes[7]     // 20       a space
        Move 228 to aBytes[8]     // E4 B8 AD U+4E2D
        Move 184 to aBytes[9]
        Move 173 to aBytes[10]
        Move 230 to aBytes[11]    // E6 96 87 U+6587
        Move 150 to aBytes[12]
        Move 135 to aBytes[13]
        Function_Return ("RDC " + UCharArrayToString(aBytes))
#ENDIF
    End_Function

    // cmd.exe makes the folder and a file in it - started through CreateProcessW from DataFlex 20, so the folder
    // gets its real name.
    Procedure Setup
        String  sTemp sBase sFolder
        Integer iChildExit

        Get_Environment "TEMP" to sTemp
        If (Right(sTemp, 1) <> "\") Begin
            Move (sTemp + "\") to sTemp
        End
        Move (sTemp + "RDCFileFunctionsTest") to sBase
        Move (sBase + "\" + FileFunctionsFolderName(Self)) to sFolder
        Set psFileFunctionsBase   to sBase
        Set psFileFunctionsFolder to sFolder

        Move (RDCRunProgramBounded("cmd.exe", ('/c mkdir "' + sFolder + '" 2>nul & echo ok> "' + sFolder + '\marker.txt"'), ".", 30)) to iChildExit
    End_Procedure

    // Removes the test's own folder under TEMP - and nothing when TEMP was not found (no drive in the path).
    Procedure TearDown
        String  sBase
        Integer iVoid

        Get psFileFunctionsBase to sBase
        If (Mid(sBase, 1, 2) = ":" and Right(sBase, 21) = "\RDCFileFunctionsTest") Begin
            Move (RDCRunProgramBounded("cmd.exe", ('/c rmdir /s /q "' + sBase + '"'), ".", 30)) to iVoid
        End
    End_Procedure

    // True when the test can open its own file. The library shows a message box when it cannot open a file, and a
    // test must not put one on the screen, so each test that lets the library open the file asks this first.
    Function FileFunctionsFileOpens String sFile Returns Boolean
#IF (!@ < 200)
        Function_Return (vFilePathExists(sFile))
#ELSE
        Handle  hFile
        Integer iVoid
        WString wFile

        Move sFile to wFile
        Move (RDCCreateFileW(AddressOf(wFile), CI_Generic_Read, CI_File_Share_Random, CI_FNull, CI_Open_Existing, CI_File_Attribute_Normal, CI_FNull)) to hFile
        If (hFile = INVALID_HANDLE_VALUE or hFile = 0) Begin
            Function_Return False
        End
        Move (fCloseHandle(hFile)) to iVoid
        Function_Return True
#ENDIF
    End_Function

    // The program's own folder: it exists, has no "\" at the end, and holds the program that runs.
    { Published=True }
    Procedure Test_ApplicationPath_Is_The_Folder_Of_The_Running_Program
        String  sPath
        Boolean bFound

        Get ApplicationPath of ghoRDCFileFunctions to sPath
        Send Assert (vFolderExists(sPath)) ("ApplicationPath names a folder that is there:" * sPath)
        Send Assert (Right(sPath, 1) <> "\") "No backslash at the end."
        Move (vFilePathExists(sPath + "\UnitTests64.exe") or vFilePathExists(sPath + "\UnitTests.exe") or vFilePathExists(sPath + "\UnitTests32.exe")) to bFound
        Send Assert bFound "The folder holds the test program."
    End_Procedure

    // FileTimeWinApi opens the file in the folder with any name (CreateFileW from DataFlex 20) and reads its times.
    { Published=True }
    Procedure Test_FileTimeWinApi_Opens_A_File_In_The_Folder
        String sFile
        tWinFileTimeDC stFileTime

        Move (psFileFunctionsFolder(Self) + "\marker.txt") to sFile
        If (FileFunctionsFileOpens(Self, sFile) = False) Begin
            Send Assert False "The test's own file could not be opened, so FileTimeWinApi was not tried."
            Procedure_Return
        End

        Get FileTimeWinApi of ghoRDCFileFunctions sFile to stFileTime
        Send AssertIAreEqual 0 stFileTime.iError "FileTimeWinApi opened the file and read its times."
    End_Procedure

    // That file's last write time as a DateTime - through GetDateFormatW and GetTimeFormatW from DataFlex 20. The file
    // was made a moment ago, so the year is this year.
    { Published=True }
    Procedure Test_WinAPIFileTimeToDateTime_Reads_The_Year_The_File_Was_Written
        String   sFile
        DateTime dtWritten
        tWinFileTimeDC stFileTime

        Move (psFileFunctionsFolder(Self) + "\marker.txt") to sFile
        If (FileFunctionsFileOpens(Self, sFile) = False) Begin
            Send Assert False "The test's own file could not be opened, so FileTimeWinApi was not tried."
            Procedure_Return
        End

        Get FileTimeWinApi of ghoRDCFileFunctions sFile to stFileTime
        Get WinAPIFileTimeToDateTime of ghoRDCFileFunctions stFileTime True to dtWritten
        Send AssertIAreEqual (DateGetYear(CurrentDateTime())) (DateGetYear(dtWritten)) "The last write time reads back as a DateTime of this year."
    End_Procedure

End_Object
