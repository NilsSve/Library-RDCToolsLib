Use VdfBase.pkg

// The span as "HH:MM:SS", the days in front as "D:" when there are any.
Function RDCTimeSpanToClock Global TimeSpan tsTime Returns String
    Integer iDays
    String sTime

    Move (SpanDays(tsTime)) to iDays
    Move "" to sTime
    If (iDays > 0) ;
        Move (String(iDays) + ":") to sTime
    Move (sTime + Right("0" + String(SpanHours(tsTime)),   2) + ":" + ;
                  Right("0" + String(SpanMinutes(tsTime)), 2) + ":" + ;
                  Right("0" + String(SpanSeconds(tsTime)), 2)) to sTime
    Function_Return sTime
End_Function

// The span as "HH:MM:SS.mmm" - the clock above with the milliseconds, zero-padded to three digits.
Function RDCTimeSpanToString Global TimeSpan tsTime Returns String
    Function_Return (RDCTimeSpanToClock(tsTime) + "." + Right("000" + String(SpanMilliSeconds(tsTime)), 3))
End_Function
